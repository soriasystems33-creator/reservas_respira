      "parameters": {
        "jsCode": "const now = new Date();\nconst offset = now.getTimezoneOffset();\nconst madridOffset = 120; // CEST (UTC+2)\nconst diff = offset + madridOffset;\nconst local = new Date(now.getTime() + diff * 60000);\nlocal.setDate(local.getDate() + 1);\nconst dateStr = local.getFullYear() + '-' +\n  String(local.getMonth() + 1).padStart(2, '0') + '-' +\n  String(local.getDate()).padStart(2, '0');\n\nconst result = [];\nitems.forEach(i => {\n  const apt = i.json;\n  const id = apt._id || apt.id;\n  if (!id) return;\n  apt.id = id;\n  const email = apt.clientEmail || apt.client_email;\n  const rawPhone = String(apt.clientPhone || apt.client_phone || '').replace(/\\D/g, '');\n  apt.clientEmail = email || '';\n  apt.clientName = (apt.clientName || apt.client_name || '').trim() || 'Cliente';\n  apt.clientPhone = rawPhone;\n  apt.isPaid = apt.isPaid !== undefined ? apt.isPaid : apt.is_paid;\n  if (apt.status === 'cancelled' || apt.status === 'noshow') return;\n  if (apt.date !== dateStr) return;\n  \n  if (!rawPhone || rawPhone.length < 9) return;\n  \n  result.push({ json: apt });\n});\nreturn result;"
      },
